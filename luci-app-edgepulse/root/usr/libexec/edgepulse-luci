#!/bin/sh

set -eu

cmd="${1:-}"
shift || true

case "$cmd" in
	status)
		exec /usr/bin/edgepulse-ctl status --json
		;;
	latest)
		exec /usr/bin/edgepulse-ctl latest --json
		;;
	features)
		window="${1:-60}"
		case "$window" in
			60|300|900|60s|5m|15m)
				exec /usr/bin/edgepulse-ctl features --json --window "$window"
				;;
			*)
				echo '{"error":"invalid feature window","features":[]}'
				exit 2
				;;
		esac
		;;
	agent-status)
		exec /usr/bin/edgepulse-ctl agent status --json
		;;
	agent-diagnose)
		message="${1:-Run a local EdgePulse diagnostic.}"
		exec /usr/bin/edgepulse-ctl agent ask "$message"
		;;
	agent-chat-list)
		conversation_id="${1:-}"
		if [ -n "$conversation_id" ]; then
			exec /usr/bin/edgepulse-ctl agent chat list "$conversation_id"
		fi
		exec /usr/bin/edgepulse-ctl agent chat list
		;;
	agent-chat-ask)
		conversation_id="${1:-default}"
		message="${2:-Run a local EdgePulse diagnostic.}"
		exec /usr/bin/edgepulse-ctl agent chat ask "$conversation_id" "$message"
		;;
	agent-action)
		action="${1:-}"
		shift || true
		confirmed=0
		service=""

		while [ "$#" -gt 0 ]; do
			case "$1" in
				--confirm)
					confirmed=1
					shift
					;;
				--service)
					service="${2:-}"
					shift 2
					;;
				*)
					echo '{"error":"unsupported EdgePulse LuCI action option"}'
					exit 2
					;;
			esac
		done

		case "$action" in
			reconnect-wan|wifi-restart|service-restart|status|wifi-status|wifi-metrics|service-status|dns-diagnose)
				;;
			*)
				echo '{"error":"unsupported EdgePulse LuCI action"}'
				exit 2
				;;
		esac

		set -- agent action "$action"
		if [ -n "$service" ]; then
			case "$service" in
				network|dnsmasq|firewall|uhttpd)
					set -- "$@" --service "$service"
					;;
				*)
					echo '{"error":"unsupported EdgePulse LuCI service"}'
					exit 2
					;;
			esac
		fi
		if [ "$confirmed" = 1 ]; then
			set -- "$@" --confirm
		fi
		exec /usr/bin/edgepulse-ctl "$@"
		;;
	agent-policy)
		exec /usr/bin/edgepulse-ctl agent policy show
		;;
	agent-mcp-methods)
		exec /usr/bin/edgepulse-ctl agent mcp methods
		;;
	agent-memory)
		exec /usr/bin/edgepulse-ctl agent memory list
		;;
	agent-models)
		exec /usr/bin/edgepulse-ctl agent models list
		;;
	agent-models-remote)
		section="${1:-}"
		exec /usr/bin/edgepulse-ctl agent models remote-list "$section"
		;;
	*)
		echo '{"error":"unsupported EdgePulse LuCI command"}'
		exit 2
		;;
esac
